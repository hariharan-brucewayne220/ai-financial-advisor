# ============================================================================
# ENVIRONMENT CONFIGURATION FOR AI FINANCIAL ADVISOR
# ============================================================================

# FastAPI & Backend
FASTAPI_ENV=development
FASTAPI_DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=postgresql+asyncpg://advisor:password123@postgres:5432/financial_advisor_db
SQLALCHEMY_ECHO=true

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_DB=1

# OpenAI API
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_BATCH_EMBEDDING=false  # Set true for production bulk embedding

# Alpha Vantage MCP / API
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
# Optional override (auto-derived from API key if not set)
# ALPHA_VANTAGE_MCP_URL=https://mcp.alphavantage.co/mcp?apikey=your-alpha-vantage-key

# AWS / LocalStack
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
S3_BUCKET=financial-advisor-docs
S3_ENDPOINT_URL=http://localstack:4566  # LocalStack for dev, empty for real AWS

# Security
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# Presidio PII Detection
PRESIDIO_ENTITIES_TO_SCAN=PERSON,ORGANIZATION,EMAIL_ADDRESS,PHONE_NUMBER,CREDIT_CARD,IBAN_CODE,URL,US_SSN,US_PASSPORT

# Logging
LOG_LEVEL=INFO
STRUCTLOG_PRETTY=true  # Pretty-print logs in development

# ARQ Worker
ARQ_POOL_SIZE=10
ARQ_JOB_TIMEOUT_SECONDS=3600

# Feature Flags
ENABLE_PII_DETECTION=true
ENABLE_FAITHFULNESS_SCORING=true
ENABLE_COMPRESSION=true
ENABLE_AUDIT_LOGGING=true
